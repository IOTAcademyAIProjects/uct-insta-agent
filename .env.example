# ============================================================
# ClawAgent v3.0 Environment Configuration
# ============================================================

# --- Core Platform Integrations ---
COMPOSIO_API_KEY=
COMPOSIO_ACCOUNT_ID=
INSTAGRAM_USER_ID=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# --- Image Hosting ---
IMGBB_API_KEY=

# --- Free AI Providers ---
# 1. Cerebras (Fastest text / JSON / intent classification - 1M free tokens/day)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# 2. NVIDIA NIM (Creative writing & captions - 40 RPM free tier)
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.2

# 3. Google Gemini (Multimodal vision & deep reasoning - 1500 RPD free tier)
GEMINI_API_KEY=

# 4. Mistral AI (Reasoning & strategy - free tier)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# 5. OpenRouter (Optional free vision fallback)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# --- Optional Paid Upgrades (Disabled by default in config/models.yaml) ---
OPENAI_API_KEY=
BANANA_API_KEY=
REPLICATE_API_TOKEN=
HUGGINGFACE_API_KEY=

# --- Multi-Platform (Optional) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
YOUTUBE_CLIENT_SECRET_FILE=

# --- Media CDN ---
MEDIA_PROVIDER=imgbb  # imgbb | cloudinary | direct
CLOUDINARY_URL=
# e.g. cloudinary://api_key:api_secret@cloud_name

# --- Telegram HITL (Human-in-the-Loop) ---
TELEGRAM_ALLOW_FROM=  # comma-separated Telegram user IDs, e.g. 123456789,987654321
API_BEARER_TOKEN=     # optional bearer for POST /api/v3/models/reload

# --- Scale / Team Deployment (Docker Compose) ---
# Solo: leave DATABASE_URL + REDIS_URL empty → SQLite + in-process queue ($0)
# Team: set both for Postgres + Redis + Celery (docker-compose.yml)
DATABASE_URL=           # e.g. postgresql://agent:clawagent@db:5432/clawagent
REDIS_URL=              # e.g. redis://redis:6379/0
# CELERY_BROKER_URL alias for REDIS_URL

# --- Settings ---
BRAND_NAME=DefaultBrand
GPU_ENABLED=false
POST_TIMEZONE=Asia/Kolkata
DB_PATH=db/uct_agent.sqlite
